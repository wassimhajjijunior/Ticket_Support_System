# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# Spring Boot API — multi-stage, layered JAR, non-root runtime
# Build context: app/    (see docker/docker-compose.yml)
# ---------------------------------------------------------------------------

# ---------- 1. build ----------
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build

# The base image already ships Maven, so we call `mvn` directly instead of the
# wrapper. `./mvnw` would download its own Maven distribution on every cold
# build — an unnecessary network dependency that has already failed CI once.
COPY pom.xml ./

# warm the Maven cache; the cache mount survives rebuilds
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -ntp -q dependency:go-offline

COPY src ./src
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -ntp -DskipTests package

# Spring Boot 3.3+ uses the `tools` jarmode (the old `layertools` is gone)
RUN java -Djarmode=tools -jar target/*.jar extract --layers --destination /extracted

# ---------- 2. runtime ----------
FROM eclipse-temurin:25-jre-alpine AS runtime

# wget is used by the healthcheck; busybox already provides it
RUN addgroup -S app && adduser -S -G app -u 1001 app

WORKDIR /app

# ordered least- to most-frequently-changing for maximum layer reuse
COPY --from=build --chown=app:app /extracted/dependencies/          ./
COPY --from=build --chown=app:app /extracted/spring-boot-loader/    ./
COPY --from=build --chown=app:app /extracted/snapshot-dependencies/ ./
COPY --from=build --chown=app:app /extracted/application/           ./

# `tools` jarmode produces a thin jar named after the artifact plus a sibling lib/.
# Rename it once so the entrypoint never depends on the Maven version string.
RUN set -eux; \
    mv /app/*.jar /app/app.jar; \
    test -f /app/app.jar

USER 1001

EXPOSE 8080

# MaxRAMPercentage makes the JVM respect the container memory limit
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:+UseContainerSupport -Djava.security.egd=file:/dev/urandom" \
    SPRING_PROFILES_ACTIVE=prod

HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/actuator/health | grep -q '"status":"UP"' || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
