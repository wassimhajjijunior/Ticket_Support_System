# Copy to docker/.env and adjust. `docker compose -f docker/docker-compose.yml`
# loads docker/.env automatically (never commit it).

# ---- published ports on your machine ----
WEB_PORT=3000
API_PORT=8080
DB_HOST_PORT=55432
ADMINER_PORT=8081

# ---- database (container-internal credentials) ----
POSTGRES_DB=ticketsupport
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets

# ---- application ----
# dev  -> runs DevDataSeeder (admin/agent1/agent2 + Platform project)
# prod -> no seeding; also set a real JWT_SECRET and real DB credentials
SPRING_PROFILES_ACTIVE=dev

# must be >= 32 characters or the API refuses to start
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_EXPIRATION_MS=3600000

# only used when SPRING_PROFILES_ACTIVE=dev
SEED_ADMIN_PASSWORD=admin123
SEED_AGENT_PASSWORD=agent123

# WARN | INFO | DEBUG  (DEBUG prints every SQL statement)
SQL_LOG_LEVEL=WARN
